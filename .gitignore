*:Zone.Identifier

/temp/*
!/temp/.gitkeep
# Retired by migrate-result-storage-to-minio and
# migrate-upload-storage-to-minio respectively; still ignored so a
# pre-migration leftover can't be committed by accident.
/outputs/
/uploads/

*.exe
# One entry per composition root: `go build ./cmd/<name>` with no -o writes
# the binary here, named after the directory.
/identity-api
/video-api
/notification-api
/worker
/notifier
/video-processor

.claude/worktrees
__pycache__/
/.env
