{
  "uid": "fiapx-overview",
  "title": "FIAP X — Visão geral",
  "description": "Pipeline de processamento de vídeo: fila, extração, entrega de notificações e as três APIs HTTP. Provisionado por arquivo (docker/grafana/dashboards).",
  "tags": [
    "fiapx"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Jobs em processamento, por estado",
      "description": "Gauge coletada na raspagem. Uma fila de 'queued' que só cresce é um worker parado.",
      "datasource": {
        "type": "prometheus",
        "uid": "fiapx-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fiapx-prometheus"
          },
          "expr": "fiapx_video_jobs_in_state",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Idade do job mais antigo, por estado",
      "description": "Sem amostra enquanto o estado está vazio — uma série que some é a fila zerada, não uma falha.",
      "datasource": {
        "type": "prometheus",
        "uid": "fiapx-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fiapx-prometheus"
          },
          "expr": "fiapx_video_jobs_oldest_in_state_age_seconds",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Extração de frames — p95 por desfecho",
      "description": "ffmpeg mais o empacotamento do ZIP, medido no worker.",
      "datasource": {
        "type": "prometheus",
        "uid": "fiapx-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fiapx-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(fiapx_video_extraction_duration_seconds_bucket[5m])))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Dispatches resolvidos pelo worker (por minuto)",
      "description": "Uma branch de handle() por rótulo. 'reject' sustentado é fila morta enchendo.",
      "datasource": {
        "type": "prometheus",
        "uid": "fiapx-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fiapx-prometheus"
          },
          "expr": "sum by (outcome) (rate(fiapx_worker_dispatch_outcomes_total[5m])) * 60",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Entrega de notificações — p95 vs. orçamento",
      "description": "A gauge é o MaxClaimHold configurado: a p95 encostando nela é o drain do notifier prestes a estourar.",
      "datasource": {
        "type": "prometheus",
        "uid": "fiapx-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "orçamento por canal"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fiapx-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, disposition) (rate(fiapx_notifier_event_delivery_duration_seconds_bucket[5m])))",
          "legendFormat": "{{disposition}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fiapx-prometheus"
          },
          "expr": "max(fiapx_notifier_delivery_max_claim_hold_seconds)",
          "legendFormat": "orçamento por canal",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Outbox não publicado / idade do mais antigo",
      "description": "Contagem e idade (s). Uma idade que cresce é um relay parado ou um broker inalcançável.",
      "datasource": {
        "type": "prometheus",
        "uid": "fiapx-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "idade —.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fiapx-prometheus"
          },
          "expr": "fiapx_video_job_outbox_unpublished",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fiapx-prometheus"
          },
          "expr": "fiapx_video_job_outbox_oldest_unpublished_age_seconds",
          "legendFormat": "idade — {{event_type}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requisições HTTP por minuto, por serviço e classe",
      "description": "As três APIs. 'job' vem do scrape config, 'status_class' do próprio contador.",
      "datasource": {
        "type": "prometheus",
        "uid": "fiapx-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fiapx-prometheus"
          },
          "expr": "sum by (job, status_class) (rate(fiapx_http_requests_total[5m])) * 60",
          "legendFormat": "{{job}} — {{status_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latência HTTP p95, por serviço",
      "description": "Inclui /metrics e as sondas, que são baratas; um p95 alto aqui é uma rota real.",
      "datasource": {
        "type": "prometheus",
        "uid": "fiapx-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fiapx-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(fiapx_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    }
  ]
}
